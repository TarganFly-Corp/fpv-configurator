@inherits LayoutComponentBase
@implements IDisposable
@inject BuildSession Session

<div class="page">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="">
                <span class="brand-mark" aria-hidden="true"></span>
                <span>FPV Configurator</span>
            </a>
            <nav class="nav" aria-label="Головне меню">
                <NavLink href="catalog">Каталог</NavLink>
                <NavLink href="build">
                    Збірка
                    @if (Session.Current.Parts.Count > 0)
                    {
                        <span class="nav-badge">@Session.Current.Parts.Count</span>
                    }
                </NavLink>
                <NavLink href="builds">Мої збірки</NavLink>
                <NavLink href="categories">Категорії</NavLink>
                <NavLink href="parts/new">Нова деталь</NavLink>
                <NavLink href="data">Імпорт і експорт</NavLink>
            </nav>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">FPV Configurator 1.0 · TarganFly-Corp · .NET 10, Blazor</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Сталася неочікувана помилка.
    <a href="." class="reload">Перезавантажити</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= Refresh;
}