# Однакові закінчення рядків у всіх копіях репозиторію
* text=auto
*.cs    text diff=csharp
*.csproj text
*.slnx  text
*.md    text
*.json  text
*.png   binary


# Службові файли Git не потрапляють в архів випуску (git archive)
.gitattributes export-ignore
.gitignore     export-ignore
.mailmap       export-ignore